  "season": "integer regular season, e.g. 2025",
  "team": "dataset team code; nfl.com renders Arizona as 'AZ' and it is mapped to 'ARI' BEFORE hashing",
  "w_l_t_pf_pa": "integers exactly as published on the official page (no padding, no thousands separators)",
  "encoding": "UTF-8, sha256 hex digest of the canonical string"
 },
